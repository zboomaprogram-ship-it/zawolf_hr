# Generate a value using: node -e "const c=require('crypto'); console.log('zwh_'+c.randomBytes(18).toString('hex')+'_'+c.randomBytes(32).toString('base64url'))"
# Set this value in the Hostinger Node application's environment, then restart.
ZAWOLF_DEVELOPER_API_SECRET=zwh_replace_with_a_36_hex_character_client_id_and_random_secret
# Optional: appears only in internal audit entries.
ZAWOLF_DEVELOPER_API_CLIENT_NAME=Approved external developer
