# Phase 008/009 real acceptance runner.
# Copy to a PRIVATE file outside source control. Never commit tokens.

ZAWOLF_008_009_ACCEPTANCE_BUILD_ID=008-009-staging-build-id

# migration | matrix | pilot | rollback
ZAWOLF_008_009_ACCEPTANCE_MODE=migration

# Required only for migration mode.
ZAWOLF_008_009_MIGRATION_FIXTURE=acceptance/008-009-migration.fixture.example.json

# Required for matrix, pilot, and rollback. Production hosts are rejected.
ZAWOLF_008_009_ACCEPTANCE_BASE_URL=https://notification-staging.example.com

# Firebase ID tokens for real NON-PRODUCTION actors. Every alias is required.
# tree_admin may have employee/manager role but must be scoped to TREE_ID.
ZAWOLF_008_009_ACCEPTANCE_TOKENS_JSON='{"employee":"REPLACE_PRIVATE_TOKEN","manager":"REPLACE_PRIVATE_TOKEN","tree_admin":"REPLACE_PRIVATE_TOKEN","hr":"REPLACE_PRIVATE_TOKEN","admin":"REPLACE_PRIVATE_TOKEN","super_admin":"REPLACE_PRIVATE_TOKEN","inactive":"REPLACE_PRIVATE_TOKEN","out_of_scope":"REPLACE_PRIVATE_TOKEN"}'

# Existing staging entities used by matrix/pilot. UIDs and IDs are never emitted
# in the sanitized evidence report.
ZAWOLF_008_009_TREE_ID=secondary-tree-staging
ZAWOLF_008_009_TARGET_EMPLOYEE_UID=staging-employee-uid
ZAWOLF_008_009_LOCATION_IDS=staging-location-a,staging-location-b

# Pilot mode is read-only verification of remote state plus real-device evidence.
# It is still guarded to prevent accidental execution.
ZAWOLF_008_009_ACCEPTANCE_ALLOW_PILOT=false
ZAWOLF_008_009_PILOT_OBSERVATIONS=acceptance/008-009-pilot-observations.example.json
ZAWOLF_008_009_MAX_P95_MS=2500
ZAWOLF_008_009_MAX_READS_PER_CHECK_IN=8
