# Non-production only. Never put tokens or production URLs in this file.
COMPANY_OS_ACCEPTANCE_BASE_URL=https://notification-staging.example.com
COMPANY_OS_ACCEPTANCE_BUILD_ID=nonprod-build-id
COMPANY_OS_ACCEPTANCE_API_VERSION=005-v1
COMPANY_OS_ACCEPTANCE_MODE=preflight

# Load the real value from a private file at runtime; do not commit it.
COMPANY_OS_ACCEPTANCE_TOKENS_JSON=

# Required in pilot mode. Each URL must be a non-production legacy fallback.
COMPANY_OS_ACCEPTANCE_LEGACY_URLS_JSON={"company_os_portal_v1":"https://web-staging.example.com/#/employee","company_os_it_v1":"https://web-staging.example.com/#/admin","company_os_requests_v1":"https://web-staging.example.com/#/requests","company_os_operations_v1":"https://web-staging.example.com/#/hr","company_os_organization_v1":"https://web-staging.example.com/#/hr/departments"}

# Set to true only for the controlled non-production pilot command.
COMPANY_OS_ACCEPTANCE_ALLOW_WRITES=false
